# Salin menjadi .env.local. Jangan commit kredensial.
DATABASE_URL=postgresql://nana:CHANGE_ME@127.0.0.1:5432/nana
BETTER_AUTH_URL=http://localhost:3000
# Generate sendiri: openssl rand -base64 32
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Folder di luar public; path absolut atau relatif dari root proyek.
STORAGE_DIR=./storage
