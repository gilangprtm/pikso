# PostgreSQL yang digunakan aplikasi Nana
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/nana

# Origin aplikasi, tanpa slash penutup
BETTER_AUTH_URL=http://localhost:3000

# Secret acak minimal 32 karakter (contoh generator: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Folder lokal privat untuk PDF dan sampul; contoh path untuk deployment Coolify:
# STORAGE_DIR=/app/storage
STORAGE_DIR=./storage

# Kredensial bootstrap admin sementara ditetapkan di scripts/create-admin.ts.
# Ganti password sebelum aplikasi dibuka untuk umum.
