{
  "name": "nana-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/copy-pdf-worker.mjs && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
